// ACI Capability Manifest (Level 4) — Authored in AJSON
// Demonstrates AJSON features: comments, multi-line strings, and reusable references.
// Compile with: ajson compile capabilities.ajson -o capabilities.json
{
  "manifest_version": "0.9.0",
  "last_updated": "2026-07-21",

  // Organization info — this becomes an ACI trust anchor
  "publisher": "NovaDynamics Inc.",

  // Reusable templates defined once, used in multiple places
  "&pricing_model": "Usage-based with reserved capacity options",

  // Evidence endpoint template — reused by every AIP action
  "&evidence_config": {
    "type": "witnessos_receipt",
    "url": "https://witnessos.empirelabs.com.au/v1/verify",
    "format": "aip-evidence-v1"
  },

  // AIP contract template reference
  "&contract_ref": {
    "id": "policy-evaluate-standard",
    "url": "https://aip.empirelabs.com.au/schemas/contract-template.json"
  },

  // Products
  "products": [
    {
      "id": "novadynamics.skyhook",
      "name": "SkyHook API",
      "type": "Cloud infrastructure management API",
      "description": "Declarative cloud orchestration with auto-scaling, multi-region deployment, and SLA monitoring."
    },
    {
      "id": "novadynamics.nexus-bot",
      "name": "NexusBot",
      "type": "Autonomous operations agent",
      "description": "AI agent for automated incident response, resource optimization, and compliance reporting."
    }
  ],

  "services": [
    {
      "id": "novadynamics.consulting",
      "name": "Infrastructure Consulting",
      "description": "Cloud architecture review, migration planning, and performance optimization."
    }
  ],

  "solutions": [
    {
      "id": "novadynamics.auto-ops",
      "name": "Autonomous Operations Suite",
      "description": "Combined SkyHook API + NexusBot for fully autonomous infrastructure management."
    }
  ],

  "industries": ["Technology", "Cloud Computing", "DevOps", "FinOps", "Compliance"],

  // Reference the pricing model template — DRY across multiple manifests
  "pricing_model": {"*pricing_model": null},

  "documentation": {
    "api-docs": "https://docs.novadynamics.example",
    "status": "https://status.novadynamics.example",
    "ai-index": "https://novadynamics.example/llms.txt"
  },

  // AIP actions with shared configurations via references
  "aip_actions": [
    {
      "id": "policy.evaluate.v1",
      "name": "Policy Evaluation",
      "version": "1.0.0",
      "description": "Evaluate an action against a compliance policy",
      "aip_schema_url": "https://aip.empirelabs.com.au/schemas/action-schema.json",
      "contract_templates": [{"*contract_ref": null}],
      "evidence_endpoints": [{"*evidence_config": null}]
    },
    {
      "id": "infra.deploy.v1",
      "name": "Infrastructure Deploy",
      "version": "1.0.0",
      "description": "Declarative deployment of cloud infrastructure resources",
      "aip_schema_url": "https://aip.empirelabs.com.au/schemas/action-schema.json",
      "contract_templates": [{"*contract_ref": null}],
      "evidence_endpoints": [{"*evidence_config": null}]
    }
  ]
}
